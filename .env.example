NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# true when running behind a load balancer/reverse proxy (uses X-Forwarded-For).
TRUST_PROXY=false

# Host port 5433 maps to the broadcast-postgres container's 5432.
DATABASE_URL=postgresql://broadcast:broadcast_dev_password@localhost:5433/broadcast
DATABASE_POOL_MAX=20

# Separate database used by `pnpm test`. Create it with `pnpm db:test:prepare`.
TEST_DATABASE_URL=postgresql://broadcast:broadcast_dev_password@localhost:5433/broadcast_test

REDIS_URL=redis://localhost:6379
# Separate Redis logical database used by `pnpm test` (flushed by tests).
TEST_REDIS_URL=redis://localhost:6379/1

# ---------------------------------------------------------------
# Authentication
# Generate secrets with: openssl rand -base64 48
# ---------------------------------------------------------------

# Signs access tokens (HS256). Min 32 chars.
JWT_ACCESS_SECRET=

# Access tokens are short-lived; refresh tokens rotate on every use.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Phone OTP challenges, stored in Redis. MSG91 generates codes of
# AUTH_OTP_CODE_LENGTH digits (4-9) that expire with the challenge;
# AUTH_OTP_TTL_SECONDS must be whole minutes (MSG91 otp_expiry).
AUTH_OTP_CODE_LENGTH=6
AUTH_OTP_TTL_SECONDS=900
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=30
AUTH_OTP_MAX_RESENDS=2

# Fixed-window limits (Redis) for /auth/phone/*. "Send" counts start and
# resend requests; limits apply per client IP and per phone number.
AUTH_OTP_RATE_WINDOW_SECONDS=3600
AUTH_OTP_SEND_IP_LIMIT=30
AUTH_OTP_SEND_PHONE_LIMIT=8
AUTH_OTP_VERIFY_IP_LIMIT=60
AUTH_OTP_VERIFY_PHONE_LIMIT=15

# ---------------------------------------------------------------
# Contact matching (POST /contacts/match). Submitted numbers are used
# for one query and never stored or logged. Limits are fixed windows.
# ---------------------------------------------------------------
# Most E.164 numbers accepted in one request (1-1000).
CONTACTS_MATCH_MAX_BATCH=500
CONTACTS_MATCH_WINDOW_SECONDS=3600
CONTACTS_MATCH_USER_REQUEST_LIMIT=60
CONTACTS_MATCH_IP_REQUEST_LIMIT=60
# Distinct numbers one account may look up per window.
CONTACTS_MATCH_USER_NUMBER_LIMIT=20000
CONTACTS_MATCH_QUERY_TIMEOUT_MS=3000

# ---------------------------------------------------------------
# Groups
# ---------------------------------------------------------------
# Most members a group may have, including the owner (2-1024).
GROUP_MAX_MEMBERS=256

# ---------------------------------------------------------------
# Broadcast lists
# ---------------------------------------------------------------
# Most recipients a broadcast list may have (1-1024).
BROADCAST_MAX_RECIPIENTS=256
# How often (ms) accepted broadcasts that still have undelivered
# recipients, e.g. after a restart, are re-driven. 0 disables the sweep.
BROADCAST_SWEEP_INTERVAL_MS=15000

# ---------------------------------------------------------------
# Media (photos, videos, documents, audio)
# Files go to a private S3 bucket (Block Public Access on, no ACLs).
# Clients upload and download only through short-lived presigned URLs
# the backend issues; AWS credentials never leave the backend and must
# never be put in the app or in EXPO_PUBLIC_* variables. Locally the
# AWS SDK reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from this
# file; in production use an IAM role instead. The credentials need
# s3:PutObject, s3:GetObject, s3:DeleteObject on attachments/*,
# profile-photos/*, group-photos/* and broadcast-list-photos/*, and
# s3:ListBucket (orphan reconciliation only). Without a bucket, media
# endpoints answer 503. Check the setup with `pnpm media:check`.
# See "Media" in docs/development.md.
# ---------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Largest file that may be shared, in bytes (product limit: 15 MB).
MEDIA_MAX_FILE_BYTES=15728640
# Lifetime of presigned upload / download URLs, in seconds.
MEDIA_UPLOAD_URL_TTL_SECONDS=900
MEDIA_DOWNLOAD_URL_TTL_SECONDS=300
# Uploads not sent in a message within this many seconds are deleted.
MEDIA_UNATTACHED_TTL_SECONDS=86400
# How often (ms) abandoned and unreferenced media is cleaned up.
# 0 disables the sweep.
MEDIA_SWEEP_INTERVAL_MS=600000

# ---------------------------------------------------------------
# Push notifications through the Expo Push Service. Only the backend
# sends pushes. See "Push notifications" in docs/development.md.
# ---------------------------------------------------------------
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push
# Optional. Required only if "Enhanced push security" is enabled for the
# Expo project (expo.dev > project > Credentials / Access tokens).
# Server-side secret: never an EXPO_PUBLIC_* variable, never committed.
EXPO_ACCESS_TOKEN=
PUSH_REQUEST_TIMEOUT_MS=10000
# How often (ms) queued pushes, retries and receipts are processed.
# Pushes are also sent right after a message commits. 0 disables.
PUSH_SWEEP_INTERVAL_MS=5000
# Send attempts per device before giving up on a push.
PUSH_MAX_ATTEMPTS=5
# A push not sent within this many seconds of the message is dropped.
PUSH_MAX_AGE_SECONDS=3600
# Wait this long after Expo accepts a push before fetching its receipt.
PUSH_RECEIPT_DELAY_SECONDS=900

# ---------------------------------------------------------------
# MSG91 SendOTP V5 API, used only by the backend to send, resend and
# verify SMS codes. Both values are required; the server will not start
# without them. Neither may ever reach the mobile app.
# https://docs.msg91.com/otp
# ---------------------------------------------------------------
MSG91_API_BASE_URL=https://control.msg91.com
# MSG91 > profile > Authkey.
MSG91_AUTH_KEY=
# MSG91 > OTP > Templates: an approved, DLT-mapped OTP template whose
# text contains ##OTP##.
MSG91_OTP_TEMPLATE_ID=
MSG91_TIMEOUT_MS=10000

# ---------------------------------------------------------------
# OpenE2EE Signal Protocol Relay
# Connection URL is public. Assertion signing material is server-only.
# Register the matching custom-token verifier in the OpenE2EE console
# before using a production connection URL.
# ---------------------------------------------------------------
# OPEN_E2EE_RELAY_URL=
# OPEN_E2EE_ASSERTION_SECRET=
# OPEN_E2EE_ASSERTION_ISSUER=
# OPEN_E2EE_ASSERTION_AUDIENCE=

