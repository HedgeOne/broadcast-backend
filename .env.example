NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# true when running behind a load balancer/reverse proxy (uses X-Forwarded-For).
TRUST_PROXY=false

# Host port 5433 maps to the broadcast-postgres container's 5432.
DATABASE_URL=postgresql://broadcast:broadcast_dev_password@localhost:5433/broadcast
DATABASE_POOL_MAX=20

# Separate database used by `pnpm test`. Create it with `pnpm db:test:prepare`.
TEST_DATABASE_URL=postgresql://broadcast:broadcast_dev_password@localhost:5433/broadcast_test

REDIS_URL=redis://localhost:6379
# Separate Redis logical database used by `pnpm test` (flushed by tests).
TEST_REDIS_URL=redis://localhost:6379/1

# ---------------------------------------------------------------
# Authentication
# Generate secrets with: openssl rand -base64 48
# ---------------------------------------------------------------

# Signs access tokens (HS256). Min 32 chars.
JWT_ACCESS_SECRET=

# Access tokens are short-lived; refresh tokens rotate on every use.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Phone OTP challenges, stored in Redis. MSG91 generates codes of
# AUTH_OTP_CODE_LENGTH digits (4-9) that expire with the challenge;
# AUTH_OTP_TTL_SECONDS must be whole minutes (MSG91 otp_expiry).
AUTH_OTP_CODE_LENGTH=6
AUTH_OTP_TTL_SECONDS=900
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=30
AUTH_OTP_MAX_RESENDS=2

# Fixed-window limits (Redis) for /auth/phone/*. "Send" counts start and
# resend requests; limits apply per client IP and per phone number.
AUTH_OTP_RATE_WINDOW_SECONDS=3600
AUTH_OTP_SEND_IP_LIMIT=30
AUTH_OTP_SEND_PHONE_LIMIT=8
AUTH_OTP_VERIFY_IP_LIMIT=60
AUTH_OTP_VERIFY_PHONE_LIMIT=15

# ---------------------------------------------------------------
# Contact matching (POST /contacts/match). Submitted numbers are used
# for one query and never stored or logged. Limits are fixed windows.
# ---------------------------------------------------------------
# Most E.164 numbers accepted in one request (1-1000).
CONTACTS_MATCH_MAX_BATCH=500
CONTACTS_MATCH_WINDOW_SECONDS=3600
CONTACTS_MATCH_USER_REQUEST_LIMIT=60
CONTACTS_MATCH_IP_REQUEST_LIMIT=60
# Distinct numbers one account may look up per window.
CONTACTS_MATCH_USER_NUMBER_LIMIT=20000
CONTACTS_MATCH_QUERY_TIMEOUT_MS=3000

# ---------------------------------------------------------------
# Groups
# ---------------------------------------------------------------
# Most members a group may have, including the owner (2-1024).
GROUP_MAX_MEMBERS=256

# ---------------------------------------------------------------
# MSG91 SendOTP V5 API, used only by the backend to send, resend and
# verify SMS codes. Both values are required; the server will not start
# without them. Neither may ever reach the mobile app.
# https://docs.msg91.com/otp
# ---------------------------------------------------------------
MSG91_API_BASE_URL=https://control.msg91.com
# MSG91 > profile > Authkey.
MSG91_AUTH_KEY=
# MSG91 > OTP > Templates: an approved, DLT-mapped OTP template whose
# text contains ##OTP##.
MSG91_OTP_TEMPLATE_ID=
MSG91_TIMEOUT_MS=10000
